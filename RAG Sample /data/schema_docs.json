{
  "tables": [
    {
      "table_name": "restaurants",
      "description": "Master data of restaurants listed on the platform.",
      "columns": [
        {"name": "restaurant_id", "type": "SERIAL", "description": "Primary key for restaurant."},
        {"name": "name", "type": "TEXT", "description": "Restaurant name."},
        {"name": "city", "type": "TEXT", "description": "City where the restaurant is located."},
        {"name": "cuisine", "type": "TEXT", "description": "Cuisine type offered by the restaurant (e.g., Indian, Chinese)."},
        {"name": "rating", "type": "NUMERIC(3,2)", "description": "Average restaurant rating from 0 to 5."}
      ]
    },
    {
      "table_name": "menu_items",
      "description": "Menu items sold by restaurants.",
      "columns": [
        {"name": "item_id", "type": "SERIAL", "description": "Primary key for menu item."},
        {"name": "restaurant_id", "type": "INT", "description": "Restaurant foreign key referencing restaurants.restaurant_id."},
        {"name": "item_name", "type": "TEXT", "description": "Name of the dish/item."},
        {"name": "category", "type": "TEXT", "description": "Menu category (Main/Starter/Dessert/Beverage)."},
        {"name": "price", "type": "NUMERIC(10,2)", "description": "Item price."},
        {"name": "is_veg", "type": "BOOLEAN", "description": "True if vegetarian, else false."}
      ]
    },
    {
      "table_name": "orders",
      "description": "Customer orders placed on the platform.",
      "columns": [
        {"name": "order_id", "type": "SERIAL", "description": "Primary key for an order."},
        {"name": "order_date", "type": "DATE", "description": "Date when the order was placed."},
        {"name": "city", "type": "TEXT", "description": "City where the order was placed."},
        {"name": "customer_segment", "type": "TEXT", "description": "Customer segment (Regular/Premium/New)."},
        {"name": "payment_method", "type": "TEXT", "description": "Payment method used (Card/UPI/Cash/Wallet)."}
      ]
    },
    {
      "table_name": "order_items",
      "description": "Line items inside each order (which menu items and quantities were purchased).",
      "columns": [
        {"name": "order_item_id", "type": "SERIAL", "description": "Primary key for an order line item."},
        {"name": "order_id", "type": "INT", "description": "Order foreign key referencing orders.order_id."},
        {"name": "item_id", "type": "INT", "description": "Menu item foreign key referencing menu_items.item_id."},
        {"name": "quantity", "type": "INT", "description": "Quantity of the item purchased (> 0)."}
      ]
    }
  ]
}